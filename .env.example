# ==========================================
# Configuración Local - Banco Chillo
# ==========================================

# Base de Datos (PostgreSQL / Supabase)
POSTGRES_USER=banco_admin
POSTGRES_PASSWORD=solo_desarrollo_local
POSTGRES_DB=banco_chillo_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=Host=localhost;Port=5432;Database=banco_chillo_dev;Username=banco_admin;Password=solo_desarrollo_local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT / Auth
JWT_SECRETO=solo-desarrollo-local-clave-jwt-banco-chillo-2026

# Supabase (Proyección remota)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
