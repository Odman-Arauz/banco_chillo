        },
        {
          "name": "Crear plantilla de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El código solo acepta MAYÚSCULAS y guion bajo (sin números).",
                  "const letras = Array.from({ length: 6 }, () => String.fromCharCode(_.random(65, 90))).join(\"\");",
                  "pm.collectionVariables.set(\"codigoPlantilla\", \"POSTMAN_\" + letras);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 creado\", () => pm.response.to.have.status(201));",
                  "const plantilla = pm.response.json();",
                  "pm.test(\"Devuelve id y el código enviado\", () => {",
                  "    pm.expect(plantilla.id).to.exist;",
                  "    pm.expect(plantilla.codigo).to.eql(pm.collectionVariables.get(\"codigoPlantilla\"));",
                  "});",
