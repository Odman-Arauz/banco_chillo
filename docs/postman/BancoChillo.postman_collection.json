      "description": "Único servicio Node.js + Express (ADR-0004). Preferencias y envíos: Issue #25 (Mateo).",
      "item": [
        {
          "name": "Listar plantillas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
