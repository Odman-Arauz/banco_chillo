{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origenes": [ "http://localhost:8081", "http://localhost:19006" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/v1/auth/{**resto}" } },
      "cajeros": { "ClusterId": "cajeros", "Match": { "Path": "/api/v1/cajeros/{**resto}" } },
      "cuentas": { "ClusterId": "cuentas", "Match": { "Path": "/api/v1/cuentas/{**resto}" } },
      "transacciones": { "ClusterId": "transacciones", "Match": { "Path": "/api/v1/transacciones/{**resto}" } },
      "creditos": { "ClusterId": "creditos", "Match": { "Path": "/api/v1/creditos/{**resto}" } },
      "auditoria": { "ClusterId": "auditoria", "Match": { "Path": "/api/v1/auditoria/{**resto}" } },
      "notificaciones": { "ClusterId": "notificaciones", "Match": { "Path": "/api/v1/notificaciones/{**resto}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "cuentas": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "transacciones": { "Destinations": { "d1": { "Address": "http://localhost:5004" } } },
      "cajeros": { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "creditos": { "Destinations": { "d1": { "Address": "http://localhost:5005" } } },
      "auditoria": { "Destinations": { "d1": { "Address": "http://localhost:5006" } } },
      "notificaciones": { "Destinations": { "d1": { "Address": "http://localhost:5007" } } }
    }
  }
}
