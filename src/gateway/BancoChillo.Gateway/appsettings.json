{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origenes": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "RateLimit": {
    "GlobalPorMinuto": 100,
    "LoginPorMinuto": 10
  },
  "SaludAgregada": {
    "TimeoutSegundos": 3
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "Order": -1,
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v1/auth/login"
        }
      },
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**resto}"
        }
      },
      "cajeros": {
        "ClusterId": "cajeros",
        "Match": {
          "Path": "/api/v1/cajeros/{**resto}"
        }
      },
      "cuentas": {
        "ClusterId": "cuentas",
        "Match": {
          "Path": "/api/v1/cuentas/{**resto}"
        }
      },
      "transacciones": {
        "ClusterId": "transacciones",
        "Match": {
          "Path": "/api/v1/transacciones/{**resto}"
        }
      },
      "creditos": {
        "ClusterId": "creditos",
        "Match": {
          "Path": "/api/v1/creditos/{**resto}"
        }
      },
      "auditoria": {
        "ClusterId": "auditoria",
        "Match": {
          "Path": "/api/v1/auditoria/{**resto}"
        }
      },
      "notificaciones": {
        "ClusterId": "notificaciones",
        "Match": {
          "Path": "/api/v1/notificaciones/{**resto}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOrPanic",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "cajeros": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOrPanic",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
